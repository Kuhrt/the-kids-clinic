{
  "kind": "singleType",
  "collectionName": "contact_infos",
  "info": {
    "singularName": "contact-info",
    "pluralName": "contact-infos",
    "displayName": "Contact Info"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": false
    },
    "phone": {
      "type": "string",
      "required": true,
      "regex": "^[\\+]?[(]?[0-9]{3}[)]?[-\\s\\.]?[0-9]{3}[-\\s\\.]?[0-9]{4,6}$"
    },
    "address": {
      "type": "text"
    },
    "longitude": {
      "type": "float"
    },
    "latitude": {
      "type": "float"
    },
    "hours": {
      "type": "component",
      "component": "time.store-hour",
      "repeatable": true,
      "max": 7
    }
  }
}
