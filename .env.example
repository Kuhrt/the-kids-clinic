# Production Environment Variables
# Copy this file to .env and fill in your values

# ===================
# PostgreSQL Database
# ===================
POSTGRES_USER=tkc_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=thekidsclinic

# ===================
# Strapi CMS
# ===================
# Generate these with: openssl rand -base64 32
CMS_APP_KEYS=key1,key2,key3,key4
CMS_API_TOKEN_SALT=your_api_token_salt
CMS_ADMIN_JWT_SECRET=your_admin_jwt_secret
CMS_TRANSFER_TOKEN_SALT=your_transfer_token_salt
CMS_ENCRYPTION_KEY=your_encryption_key
CMS_JWT_SECRET=your_jwt_secret

# ===================
# Next.js Web
# ===================
NEXT_PUBLIC_CMS_API_URL=https://cms.thekids.clinic/api
NEXT_PUBLIC_CMS_API_KEY=your_strapi_api_key
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MAPBOX_KEY=pk.xxxxx
